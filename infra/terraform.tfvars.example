# Copy to terraform.tfvars (ignored). Never put passwords in this file.
account_id   = "REPLACE_WITH_12_DIGIT_ACCOUNT_ID"
budget_email = "you@example.com"
region       = "us-east-2"
# Keep -1 if the account has a low Lambda quota.
lambda_reserved_concurrency = -1
# The intentionally weak synthetic agent profile is disabled by default.
# A short UTC end time is required before administrator-approved enablement.
demo_vulnerable_enabled   = false
demo_vulnerable_until_utc = ""
